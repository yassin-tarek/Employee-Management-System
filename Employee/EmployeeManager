public class EmployeeManager {

    private ArrayList<Employee> employees = new ArrayList<>();

    public boolean addEmployee(Employee e) {

        if (e == null || searchEmployee(e.getId()) != null) { //Basically it means that if e is null return falss or if id added already exists
            return false;
        }

        employees.add(e);
        return true;
    }

    public boolean deleteEmployee(int id) {//NOT WRITTEN DELETE BY WHAT I WROTE ID AS IT IS UNIQUE FOR EACH EMPLOYEE

        Employee e = searchEmployee(id);

        if (e == null) {
            return false;
        }

        employees.remove(e);
        return true;
    }
}
