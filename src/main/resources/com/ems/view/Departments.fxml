<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ems.controller.DepartmentsController"
            fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="@../css/Departments.css" />
    </stylesheets>

    <VBox spacing="20">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32" />
        </padding>

        <!-- Success / error message -->
        <Label fx:id="statusMessage" wrapText="true" maxWidth="Infinity" />

        <!-- Add a department -->
        <VBox styleClass="page-card, dept-card" spacing="14">
            <Label text="Add a New Department" styleClass="card-title" />
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="newNameField" promptText="e.g. Customer Support" HBox.hgrow="ALWAYS"
                           onAction="#onAdd" />
                <Button text="+ Add Department" styleClass="primary-button" onAction="#onAdd" />
            </HBox>
        </VBox>

        <!-- Department list -->
        <VBox styleClass="page-card, dept-card" spacing="8">
            <Label fx:id="listTitle" styleClass="card-title" />
            <VBox fx:id="departmentRows" spacing="0" />
        </VBox>
    </VBox>
</ScrollPane>
