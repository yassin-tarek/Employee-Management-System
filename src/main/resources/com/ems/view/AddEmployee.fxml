<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ems.controller.AddEmployeeController"
            fitToWidth="true" hbarPolicy="NEVER">

    <stylesheets>
        <URL value="@../css/AddEmployee.css" />
    </stylesheets>

    <VBox spacing="20">
        <padding>
            <Insets top="28" right="32" bottom="28" left="32" />
        </padding>

        <!-- Error / success message -->
        <Label fx:id="formMessage" wrapText="true" maxWidth="Infinity" />

        <HBox spacing="20" fillHeight="false">

            <!-- ============ Profile picture ============ -->
            <VBox styleClass="page-card, form-card" prefWidth="260" minWidth="260" maxWidth="260"
                  spacing="16" alignment="TOP_CENTER">
                <Label text="Profile Picture" styleClass="section-title" maxWidth="Infinity" />

                <StackPane styleClass="avatar-large" minWidth="140" minHeight="140"
                           prefWidth="140" prefHeight="140" maxWidth="140" maxHeight="140">
                    <Label fx:id="avatarInitial" text="?" styleClass="avatar-initial" />
                    <ImageView fx:id="profileImage" fitWidth="140" fitHeight="140" visible="false" />
                </StackPane>

                <Button fx:id="chooseImageButton" text="Choose Image" styleClass="secondary-button"
                        maxWidth="Infinity" onAction="#onChooseImage" />
                <Button fx:id="removeImageButton" text="Remove" styleClass="secondary-button"
                        maxWidth="Infinity" onAction="#onRemoveImage" />

                <Label text="PNG, JPG or GIF, up to 5 MB." styleClass="hint-label" wrapText="true" />
            </VBox>

            <!-- ============ Form sections ============ -->
            <VBox HBox.hgrow="ALWAYS" spacing="20">

                <!-- Personal information -->
                <VBox styleClass="page-card, form-card" spacing="18">
                    <Label text="Personal Information" styleClass="section-title" />
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Full Name" styleClass="field-label" />
                            <TextField fx:id="nameField" promptText="e.g. Sara Ali" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Age" styleClass="field-label" />
                            <TextField fx:id="ageField" promptText="e.g. 28" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Email" styleClass="field-label" />
                            <TextField fx:id="emailField" promptText="name@company.com" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Phone" styleClass="field-label" />
                            <TextField fx:id="phoneField" promptText="e.g. +20 100 123 4567" />
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Job information -->
                <VBox styleClass="page-card, form-card" spacing="18">
                    <Label text="Job Information" styleClass="section-title" />
                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Employee ID" styleClass="field-label" />
                            <TextField fx:id="employeeIdField" editable="false" focusTraversable="false"
                                       styleClass="readonly-field" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Department" styleClass="field-label" />
                            <ComboBox fx:id="departmentCombo" promptText="Select department" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Position" styleClass="field-label" />
                            <TextField fx:id="positionField" promptText="e.g. Software Engineer" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Hire Date" styleClass="field-label" />
                            <DatePicker fx:id="hireDatePicker" maxWidth="Infinity" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label text="Employee Type" styleClass="field-label" />
                            <ComboBox fx:id="typeCombo" maxWidth="Infinity" />
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Salary information (changes with the employee type) -->
                <VBox styleClass="page-card, form-card" spacing="18">
                    <Label text="Salary Information" styleClass="section-title" />

                    <GridPane fx:id="fullTimeGrid" hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Monthly Salary" styleClass="field-label" />
                            <TextField fx:id="salaryField" promptText="e.g. 8000" />
                        </VBox>
                    </GridPane>

                    <GridPane fx:id="partTimeGrid" hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>
                        <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Hourly Rate" styleClass="field-label" />
                            <TextField fx:id="hourlyRateField" promptText="e.g. 50" />
                        </VBox>
                        <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Hours Worked" styleClass="field-label" />
                            <TextField fx:id="hoursField" promptText="e.g. 80" />
                        </VBox>
                    </GridPane>

                    <Label fx:id="salaryPreview" styleClass="salary-preview" />
                </VBox>
            </VBox>
        </HBox>

        <!-- Buttons -->
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button text="Reset Form" styleClass="secondary-button" onAction="#onReset" />
            <Button text="Cancel" styleClass="secondary-button" onAction="#onCancel" />
            <Button fx:id="submitButton" text="Add Employee" styleClass="primary-button" onAction="#onSubmit" />
        </HBox>
    </VBox>
</ScrollPane>
