<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ems.controller.ShellController" styleClass="shell">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="12">
                <Label text="EMS" styleClass="logo-badge" />
                <VBox>
                    <Label text="Employee" styleClass="brand-name" />
                    <Label text="Management System" styleClass="brand-caption" />
                </VBox>
            </HBox>

            <Label text="MENU" styleClass="sidebar-section" />

            <Button fx:id="dashboardNav" text="Dashboard" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#showDashboard" />
            <Button fx:id="addEmployeeNav" text="Add Employee" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#showAddEmployee" />
            <Button fx:id="employeeListNav" text="Employees" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#showEmployeeList" />
            <Button fx:id="departmentsNav" text="Departments" styleClass="nav-button" maxWidth="Infinity"
                    onAction="#showDepartments" />

            <Region VBox.vgrow="ALWAYS" />

            <Button text="Logout" styleClass="logout-button" maxWidth="Infinity" onAction="#logout" />
        </VBox>
    </left>

    <!-- Header -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="16">
            <Label fx:id="pageTitle" styleClass="header-title" />
            <Region HBox.hgrow="ALWAYS" />
            <HBox styleClass="user-chip" alignment="CENTER_LEFT" spacing="10">
                <Label text="A" styleClass="avatar" />
                <VBox>
                    <Label text="Admin" styleClass="user-name" />
                    <Label text="Administrator" styleClass="user-role" />
                </VBox>
            </HBox>
        </HBox>
    </top>

    <!-- Page content goes here -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>
</BorderPane>
