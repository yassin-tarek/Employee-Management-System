<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ems.controller.EmployeeListController" spacing="20">

    <stylesheets>
        <URL value="@../css/EmployeeList.css" />
    </stylesheets>

    <padding>
        <Insets top="28" right="32" bottom="28" left="32" />
    </padding>

    <!-- Message after deleting -->
    <Label fx:id="statusMessage" wrapText="true" maxWidth="Infinity" />

    <!-- Search and filters -->
    <HBox styleClass="page-card, toolbar" spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search by name or ID" prefWidth="300" />
        <ComboBox fx:id="departmentFilter" prefWidth="200" />
        <ComboBox fx:id="typeFilter" prefWidth="160" />
        <Button text="Clear" styleClass="secondary-button" onAction="#onClearFilters" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="+ Add Employee" styleClass="primary-button" onAction="#onAddEmployee" />
    </HBox>

    <!-- Table -->
    <VBox styleClass="page-card, table-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="employeeCol" text="EMPLOYEE" prefWidth="280" />
                <TableColumn fx:id="idCol" text="ID" prefWidth="60" />
                <TableColumn fx:id="departmentCol" text="DEPARTMENT" prefWidth="150" />
                <TableColumn fx:id="positionCol" text="POSITION" prefWidth="170" />
                <TableColumn fx:id="typeCol" text="TYPE" prefWidth="110" />
                <TableColumn fx:id="salaryCol" text="SALARY" prefWidth="120" />
                <TableColumn fx:id="actionsCol" text="ACTIONS" prefWidth="230" sortable="false" />
            </columns>
        </TableView>
        <Label fx:id="countLabel" styleClass="count-label" maxWidth="Infinity" />
    </VBox>
</VBox>
